# Origins allowed to call the Store API (browser-side requests come from the storefront)
STORE_CORS=http://localhost:3000,https://docs.medusajs.com
# Origins allowed to call the Admin API (built-in admin + custom studio)
ADMIN_CORS=http://localhost:9000,http://localhost:3000,https://docs.medusajs.com
# Origins allowed to call auth endpoints
AUTH_CORS=http://localhost:9000,http://localhost:3000,https://docs.medusajs.com
# Managed Redis connection (e.g. Upstash). Leave empty locally to use the in-memory fake redis.
REDIS_URL=
# Required in production. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=
AUTH_MFA_ENCRYPTION_KEY=
# Postgres connection string. Hosted databases need ?sslmode=require. Use the session/direct port, not a transaction pooler.
DATABASE_URL=
DB_NAME=medusa-backend
# Google Sheets order mirror. Set both to enable; leave empty to disable.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_TOKEN=
